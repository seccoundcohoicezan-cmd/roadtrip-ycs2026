{
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/design/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ycs-data.169-58-232-156.sslip.io/api/:path*"
    },
    {
      "source": "/srv/monster",
      "destination": "https://ycs-data.169-58-232-156.sslip.io/api/monster"
    },
    {
      "source": "/srv/pemenang",
      "destination": "https://ycs-data.169-58-232-156.sslip.io/api/pemenang"
    }
  ]
}

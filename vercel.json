{
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "regions": [
    "sin1"
  ],
  "rewrites": [
    {
      "source": "/srv/monster",
      "destination": "https://ycs-data.194-238-23-221.sslip.io/monster"
    },
    {
      "source": "/srv/pemenang",
      "destination": "https://ycs-data.194-238-23-221.sslip.io/monster/pemenang"
    }
  ]
}
